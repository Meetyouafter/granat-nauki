{
  "name": "admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run lint:css:check",
    "preview": "vite preview",
    "gen:api-types": "openapi-typescript http://localhost:4000/api-json -o src/shared/api/generated.d.ts",
    "lint:css": "stylelint \"src/**/*.scss\" --fix",
    "lint:css:check": "stylelint \"src/**/*.scss\""
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@granat/contracts": "workspace:*",
    "react": "^19.2.7",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.7",
    "react-redux": "^9.3.0",
    "react-router": "^8.3.0",
    "redux": "^5.0.1"
  },
  "devDependencies": {
    "@granat/eslint-config": "workspace:*",
    "@granat/stylelint-config": "workspace:*",
    "@granat/tsconfig": "workspace:*",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.21",
    "classnames": "^2.5.1",
    "eslint": "catalog:",
    "eslint-plugin-react-refresh": "^0.5.3",
    "openapi-typescript": "^7.13.0",
    "sass": "^1.101.7",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.1.1"
  }
}
