{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development next dev -p 3000",
    "build": "NODE_ENV=production next build",
    "start": "NODE_ENV=production next start",
    "prod": "pnpm run build && pnpm run start",
    "lint:css": "stylelint \"src/**/*.scss\" --fix",
    "lint": "eslint .",
    "lint:css:check": "stylelint \"src/**/*.scss\"",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run lint:css:check"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@granat/contracts": "workspace:*",
    "classnames": "^2.5.1",
    "next": "^16.3.6",
    "next-intl": "^4.14.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^18.0.3",
    "eslint": "^9.38.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^16.4.0",
    "jiti": "^2.6.1",
    "postcss-scss": "^4.0.9",
    "prisma": "^7.10.0",
    "sass": "^1.93.2",
    "stylelint": "^17.14.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "typescript-eslint": "^8.46.2"
  }
}
