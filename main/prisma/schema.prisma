// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER

  @@map("role")
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("access_request_status")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  hash        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions              Session[]
  accessRequests        AccessRequest[] @relation("AccessRequestAuthor")
  decidedAccessRequests AccessRequest[] @relation("AccessRequestDecider")

  @@map("users")
}

model Session {
  id             String   @id
  secretHash     Bytes    @map("secret_hash")
  userId         Int      @map("user_id")
  userAgent      String?  @map("user_agent")
  ip             String?
  lastVerifiedAt DateTime @default(now()) @map("last_verified_at")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AccessRequest {
  id          Int                 @id @default(autoincrement())
  userId      Int                 @map("user_id")
  status      AccessRequestStatus @default(PENDING)
  decidedById Int?                @map("decided_by_id")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  user      User  @relation("AccessRequestAuthor", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("AccessRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([decidedById])
  @@map("access_requests")
}
